# 选择一个 Provider：anthropic、openai 或 gemini
LLM_PROVIDER=
MODEL_ID=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# OpenAI（Responses API）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Gemini
GEMINI_API_KEY=

# 本地编排默认使用项目 .penhin/orchestration.sqlite3。
# PostgreSQL 示例：postgresql://user:password@host:5432/database
PENHIN_DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# 编排与 SQLite（留空时使用程序默认值）
PENHIN_SCHEDULER_WORKERS=
PENHIN_WORKER_KILL_GRACE_SECONDS=
PENHIN_SYNC_AGENT_TIMEOUT_SECONDS=
PENHIN_AGENT_POLL_INTERVAL_SECONDS=
PENHIN_SQLITE_CONNECT_TIMEOUT_SECONDS=
PENHIN_SQLITE_BUSY_TIMEOUT_MS=

# Agent 真实评测（价格单位：每百万 token 的美元价格）
PENHIN_EVAL_JUDGE_PROVIDER=gemini
PENHIN_EVAL_JUDGE_MODEL=gemini-3-flash-preview
PENHIN_EVAL_PRIMARY_INPUT_USD_PER_MTOK=
PENHIN_EVAL_PRIMARY_OUTPUT_USD_PER_MTOK=
PENHIN_EVAL_JUDGE_INPUT_USD_PER_MTOK=0.50
PENHIN_EVAL_JUDGE_OUTPUT_USD_PER_MTOK=3.00
PENHIN_EVAL_MAX_TOTAL_TOKENS=6000000
PENHIN_EVAL_MAX_USD=30
PENHIN_EVAL_MAX_CASE_TOKENS=120000
PENHIN_EVAL_MAX_MULTI_AGENT_TOKENS=500000
PENHIN_EVAL_MAX_JUDGE_TOKENS=8000
PENHIN_EVAL_WORKERS=3
PENHIN_EVAL_MIN_FREE_BYTES=536870912

# Provider、功能与界面
PENHIN_SKIP_MODEL_COMPATIBILITY_CHECK=
PENHIN_ADVERTISE_SKILLS=
PENHIN_VERSION=

# 主调用断路器
CIRCUIT_BREAKER_ENABLED=
CIRCUIT_BREAKER_FAILURE_THRESHOLD=
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=

# 上下文压缩调用断路器
COMPACT_CIRCUIT_BREAKER_ENABLED=
COMPACT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=
COMPACT_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=
COMPACT_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=

# 网络代理（可选）
HTTPS_PROXY=
HTTP_PROXY=
