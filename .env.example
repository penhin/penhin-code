ANTHROPIC_API_KEY=sk-ant-xxx
MODEL_ID=claude-sonnet-4-6

# Optional: Anthropic-compatible provider
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI provider alternative
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini provider alternative
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# Orchestration storage defaults to .penhin/orchestration.sqlite3 in the project.
# To use PostgreSQL instead, uncomment and configure these values:
# POSTGRES_DB=penhin
# POSTGRES_USER=penhin
# POSTGRES_PASSWORD=penhin-dev-password
# POSTGRES_PORT=55432
# PENHIN_DATABASE_URL=postgresql://penhin:penhin-dev-password@localhost:55432/penhin
# An explicit SQLite location is also supported:
# PENHIN_DATABASE_URL=sqlite:////absolute/path/to/orchestration.sqlite3
PENHIN_SCHEDULER_WORKERS=2
PENHIN_WORKER_KILL_GRACE_SECONDS=2
# PENHIN_SYNC_AGENT_TIMEOUT_SECONDS=900
# PENHIN_AGENT_POLL_INTERVAL_SECONDS=0.1
# PENHIN_SQLITE_CONNECT_TIMEOUT_SECONDS=5
# PENHIN_SQLITE_BUSY_TIMEOUT_MS=5000
