# 通常无需复制本文件：启动 Penhin 后使用 /login 选择认证方式、
# Provider 和模型。这里只保留高级功能配置。

# 自定义 API 网关（可选）
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=

# PostgreSQL 编排后端（可选；留空时使用本地 SQLite）
PENHIN_DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# 真实 Agent 评测
# Judge Provider 默认为 gemini；预算默认值见 docs/evaluation.md。
PENHIN_EVAL_JUDGE_MODEL=
PENHIN_EVAL_PRIMARY_INPUT_USD_PER_MTOK=
PENHIN_EVAL_PRIMARY_OUTPUT_USD_PER_MTOK=
PENHIN_EVAL_JUDGE_INPUT_USD_PER_MTOK=
PENHIN_EVAL_JUDGE_OUTPUT_USD_PER_MTOK=
